{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32F103 with ST-Link",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Release/Stm32F103.elf",
            "servertype": "openocd",
            "serverpath": "openocd",
            "configFiles": [
                "${workspaceFolder}/openocd.cfg"
            ],
            "runToEntryPoint": "main"
        },
        {
            "name": "C/C++: arm-none-eabi-gcc 构建和调试活动文件",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "C/C++: arm-none-eabi-gcc 生成活动文件"
        },
        {
            "name": "C/C++: gcc 构建和调试活动文件",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "C/C++: gcc 生成活动文件"
        }
    ]
}